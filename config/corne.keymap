#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        qwerty {
            bindings = <&mo 3>;
            key-positions = <36 36 41>;
            layers = <1 2 0 3>;
        };
    };

    behaviors {
        rpi: require_prior_idle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CAPS |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | CTRL |
            //                    | CMD | LWR | RET |   | SPC | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB   &kp Q            &kp W                &kp F            &kp P              &kp B      &kp J      &kp L               &kp U             &kp Y                 &kp SEMICOLON    &mo 3
&kp CAPS  &rpi LEFT_ALT A  &rpi LEFT_CONTROL R  &rpi LEFT_GUI S  &rpi LEFT_SHIFT T  &kp G      &kp M      &rpi RIGHT_SHIFT N  &rpi RIGHT_GUI E  &rpi RIGHT_CONTROL I  &rpi LEFT_ALT O  &kp SQT
&mo 4     &kp Z            &kp X                &kp C            &kp D              &kp V      &kp K      &kp H               &kp COMMA         &kp DOT               &kp FSLH         &mo 4
                                                &mo 1            &kp BACKSPACE      &kp RET    &kp SPACE  &kp BSPC            &mo 2
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | CAPS | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TAB    &kp STAR            &kp N7                &kp N8                &kp N9         &kp PLUS      &kp CARET    &kp AMPS            &kp LBKT                             &kp RBKT                 &kp DOLLAR           &trans
&kp CAPS   &rpi LEFT_ALT FSLH  &rpi LEFT_CONTROL N4  &rpi LEFT_COMMAND N5  &rpi LSHFT N6  &kp MINUS     &kp PERCENT  &rpi RSHFT AT_SIGN  &rpi RIGHT_COMMAND LEFT_PARENTHESIS  &rpi RIGHT_CONTROL RPAR  &rpi RIGHT_ALT BSLH  &kp GRAVE
&kp LSHFT  &kp N0              &kp N1                &kp N2                &kp N3         &kp EQUAL     &kp UNDER    &kp HASH            &kp LBRC                             &kp RBRC                 &kp PERIOD           &trans
                                                     &trans                &kp DEL        &kp PERIOD    &trans       &trans              &mo 3
            >;
        };

        nav_media {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CAPS |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&trans    &trans             &kp F7                &kp F8        &kp F9              &kp F10    &kp C_PLAY_PAUSE  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans          &trans      &trans
&kp HOME  &rpi LEFT_ALT END  &rpi LEFT_CONTROL F4  &rpi LCMD F5  &rpi LEFT_SHIFT F6  &kp F11    &kp LEFT          &kp DOWN              &kp UP                &kp RIGHT       &trans      &trans
&kp INS   &kp DEL            &kp F1                &kp F2        &kp F3              &kp F12    &kp C_PLAY_PAUSE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PREVIOUS  &kp C_NEXT  &trans
                                                   &mo 3         &trans              &trans     &trans            &trans                &trans
            >;
        };

        META {
            bindings = <
&bt BT_CLR         &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &to 5
&ext_power EP_OFF  &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &to 0
&ext_power EP_ON   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                               &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };

        MODS {
            bindings = <
&trans  &trans    &trans     &trans    &trans     &trans    &trans  &trans     &trans    &trans     &trans    &trans
&trans  &sk LALT  &sk LCTRL  &sk LGUI  &sk LSHFT  &trans    &trans  &sk RSHFT  &sk RGUI  &sk RCTRL  &sk LALT  &trans
&trans  &trans    &trans     &trans    &trans     &trans    &trans  &trans     &trans    &trans     &trans    &trans
                             &trans    &trans     &trans    &trans  &trans     &trans
            >;
        };

        qwerty {
            bindings = <
&kp Q      &kp W  &kp E  &kp R  &kp T   &kp Y     &kp U   &kp I   &kp O      &kp P    &kp LBKT  &kp RBKT
&kp CAPS   &kp A  &kp S  &kp D  &kp F   &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp RSHFT  &kp Z  &kp X  &kp C  &kp V   &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &mo 1  &trans  &trans    &trans  &trans  &mo 2
            >;
        };
    };
};
